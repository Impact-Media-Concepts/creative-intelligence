# Supabase — Project Settings > Data API (URL) en API Keys
PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# AI usage-proxy — alle Claude-calls lopen hierlangs (niet meer direct naar Anthropic)
API_USAGE_KEY=auk_xxx
API_USAGE_CONNECTION_ID=<connection-id-uit-de-proxy-UI>
API_USAGE_URL=https://api-usage.onlineklik.dev/api/v1/proxy

# Modellabel (voor logging; de connectie bepaalt het echte model)
ANTHROPIC_MODEL=claude-sonnet-5

# Meta Marketing API — Sprint-automatisering (advertentieresultaten automatisch uitlezen)
# App aanmaken op https://developers.facebook.com > App > "Marketing API".
META_APP_ID=
META_APP_SECRET=
# Redirect-URI moet exact in de Meta-app (Facebook Login > Valid OAuth Redirect URIs) staan.
# Laat leeg om automatisch <origin>/api/meta/callback te gebruiken.
META_REDIRECT_URI=https://<jouw-domein>/api/meta/callback
META_API_VERSION=v21.0

# Cron-beveiliging: willekeurige string; Vercel stuurt 'm mee als Bearer-token.
CRON_SECRET=change-me
